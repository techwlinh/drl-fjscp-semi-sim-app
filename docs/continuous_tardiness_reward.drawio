        <!-- Job Urgency Card -->
        <mxCell id="job_urgency_card" value="&lt;b&gt;Job Urgency Features (Per Job j)&lt;/b&gt;&lt;br&gt;&lt;hr&gt;&lt;div align=&quot;left&quot; style=&quot;padding-left:10px;&quot;&gt;• &lt;b&gt;Slack Time Margin:&lt;/b&gt; $$\text{Slack}_j = d_j - (t_{\text{curr}} + \text{RemProc}_j)$$&lt;br&gt;  Normalized: $$\tilde{s}_j = \tanh(\text{Slack}_j / \bar{d})$$&lt;br&gt;  &lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;⚠ If Slack_j &lt; 0 ⇒ Tardiness Risk Alert!&lt;/b&gt;&lt;/font&gt;&lt;br&gt;• &lt;b&gt;Priority Weight:&lt;/b&gt; Super_Hot (10×) &gt; Hot (3×) &gt; Regular (1×)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94A3B8;strokeWidth=1.2;align=center;verticalAlign=top;" vertex="1" parent="1">
